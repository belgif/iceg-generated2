      "vocDefinition": [
        {
          "@language": "en",
          "@value": "Type of physical outlet of a fire hydrant to which a hose or coupling can be connected for the withdrawal of firefighting water."
        },
        {
          "@language": "fr",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "en",
          "@value": "type outlet"
        },
        {
          "@language": "fr",
          "@value": "Enter your translation here"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "This attribute specifies the type of coupling of a fire hydrant outlet.\nCommonly used outlet types include DSP and Storz.The outlet type is not modelled as a closed codelist because the set of possible outlet connections is not guaranteed to be exhaustive."
        }
      ]
    },
