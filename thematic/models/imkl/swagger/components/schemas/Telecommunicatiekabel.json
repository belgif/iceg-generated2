{
  "title": "Telecommunicatiekabel",
  "type": "object",
  "description": "Een Nutsvoorzieninglinkset die wordt gebruikt om datasignalen (PSTN, radio of computer) van de ene locatie naar de andere te transporteren.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Telecommunicatiekabel)",
      "pattern": "^Telecommunicatiekabel$"
    },
    "telecommunicatiekabelmateriaaltype": {
      "$ref": "#/components/schemas/Telecommunicatiekabelmateriaaltype"
    },
    "kabeldiameter": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Maat"
        },
        {
          "$ref": "#/components/schemas/Lengte"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Maat": "#/components/schemas/Maat",
          "Lengte": "#/components/schemas/Lengte"
        }
      }
    },
    "subthema": {
      "$ref": "#/components/schemas/Subthema"
    },
    "technischeSpecificatie": {
      "type": "array",
      "description": "Lijst van LangString items.",
      "items": {
        "type": "object",
        "description": "Nadere bepaling van de linkset. Bijvoorbeeld 4g10 om 4-aderige kabel van 10mm doorsnee te specifiëren.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1
    },
    "zichtbaarheid": {
      "$ref": "#/components/schemas/Zichtbaarheidstype"
    },
    "risico": {
      "type": "array",
      "description": "Lijst van RisicoType items.",
      "items": {
        "$ref": "#/components/schemas/RisicoType"
      },
      "minItems": 1
    },
    "uiterlijk": {
      "$ref": "#/components/schemas/Uiterlijk"
    },
    "materiaaltype": {
      "$ref": "#/components/schemas/MateriaalType"
    },
    "inNetwerk": {
      "type": "array",
      "description": "Lijst van Nutsvoorzieningnetwerk items.",
      "items": {
        "$ref": "#/components/schemas/Nutsvoorzieningnetwerk"
      },
      "minItems": 1
    },
    "link": {
      "type": "array",
      "description": "Lijst van GeneriekeLink items.",
      "items": {
        "$ref": "#/components/schemas/GeneriekeLink"
      },
      "minItems": 1
    },
    "nutsvoorzieningleveringstype": {
      "$ref": "#/components/schemas/Nutsvoorzieningleveringstype"
    },
    "waarschuwingstype": {
      "$ref": "#/components/schemas/Waarschuwingstype"
    },
    "geldigVan": {
      "type": "object",
      "description": "Tijdstip vanaf wanneer het element in de werkelijkheid bestond.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "geldigTot": {
      "type": "object",
      "description": "Tijdstip tot wanneer het element in de werkelijkheid bestond.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "verticalePositiedetail": {
      "type": "array",
      "description": "Lijst van VerticalePositie items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/VerticalePositie"
          },
          {
            "$ref": "#/components/schemas/Hoogte"
          },
          {
            "$ref": "#/components/schemas/Diepte"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "VerticalePositie": "#/components/schemas/VerticalePositie",
            "Hoogte": "#/components/schemas/Hoogte",
            "Diepte": "#/components/schemas/Diepte"
          }
        }
      },
      "minItems": 1
    },
    "verticalePositie": {
      "$ref": "#/components/schemas/VerticalePositietype"
    },
    "identificator": {
      "$ref": "#/components/schemas/Identificator"
    },
    "documentatie": {
      "type": "array",
      "description": "Lijst van Document items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Document"
          },
          {
            "$ref": "#/components/schemas/Plan"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Document": "#/components/schemas/Document",
            "Plan": "#/components/schemas/Plan"
          }
        }
      },
      "minItems": 1
    },
    "huidigeStatus": {
      "$ref": "#/components/schemas/Faciliteitstatus"
    },
    "nutsvoorzieningInrichtingReferentie": {
      "type": "array",
      "description": "Lijst van Activiteitencomplex items.",
      "items": {
        "$ref": "#/components/schemas/Activiteitencomplex"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "telecommunicatiekabelmateriaaltype",
    "inNetwerk",
    "link",
    "waarschuwingstype",
    "geldigVan",
    "verticalePositie",
    "huidigeStatus"
  ]
}