{
  "title": "Opmeting",
  "type": "object",
  "description": "Het bepalen van de precieze omvang van iets door het te meten.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Opmeting)",
      "pattern": "^Opmeting$"
    },
    "datum": {
      "type": "object",
      "description": "Het moment waarop de Opmeting heeft plaatsgevonden",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "methode": {
      "$ref": "#/components/schemas/Opmetingsmethode"
    },
    "uitgevoerdDoor": {
      "$ref": "#/components/schemas/Agent"
    },
    "nauwkeurigheid": {
      "$ref": "#/components/schemas/PositioneleNauwkeurigheid"
    }
  },
  "required": [
    "@type",
    "methode"
  ]
}