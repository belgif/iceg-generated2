{
  "title": "Document",
  "type": "object",
  "description": "Informatie vastgelegd op een gegevensdrager.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Document)",
      "pattern": "^Document$"
    },
    "documentlocatie": {
      "type": "object",
      "description": "De plaats waar het Document is opgeslagen of raadpleegbaar is.",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "beschrijving": {
      "type": "object",
      "description": "Beschrijving van het Document.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "documentmediumtype": {
      "$ref": "#/components/schemas/Documentmediumtype"
    },
    "documentType": {
      "$ref": "#/components/schemas/Documenttype"
    },
    "documentidentificator": {
      "$ref": "#/components/schemas/Identificator"
    },
    "verwijstNaar": {
      "type": "array",
      "description": "Lijst van Object items.",
      "items": {
        "$ref": "#/components/schemas/Object"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "documentlocatie",
    "documentmediumtype",
    "documentType"
  ]
}