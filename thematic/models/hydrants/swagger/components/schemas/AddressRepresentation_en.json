{
  "title": "AddressRepresentation",
  "type": "object",
  "description": "More readable representation with only the basic data of the address, intended to use an address as an attribute of another object.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse AddressRepresentation)",
      "pattern": "^AddressRepresentation$"
    },
    "houseNumber": {
      "$ref": "#/components/schemas/AddressRepresentation.houseNumber"
    },
    "postalcode": {
      "$ref": "#/components/schemas/AddressRepresentation.postalcode"
    },
    "streetname": {
      "$ref": "#/components/schemas/GeographicalName"
    },
    "municipalityName": {
      "$ref": "#/components/schemas/GeographicalName"
    }
  },
  "required": [
    "@type"
  ]
}